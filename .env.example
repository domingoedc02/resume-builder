# Public Appwrite project configuration. Safe to expose in the browser.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_RESUMES_TABLE_ID=resumes

# Server-only Appwrite API key; grant only required table/database scopes.
APPWRITE_API_KEY=

# Custom OpenAI-compatible API endpoint. These values must remain server-only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_RATE_LIMIT_PER_HOUR=30
